<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Input Section Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/CardViewStyle">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/SectionTitleStyle"
                    android:text="Input Parameters"
                    android:padding="0dp"
                    android:paddingBottom="8dp" />

                <!-- Sample -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/sampleInputLayout"
                    style="@style/InputFieldStyle"
                    android:hint="@string/sample">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etSample"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Date -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/dateInputLayout"
                    style="@style/InputFieldStyle"
                    android:hint="@string/date">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="false"
                        android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Rack Number -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/rackNumberInputLayout"
                    style="@style/InputFieldStyle"
                    android:hint="@string/rack_number">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etRackNumber"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Source -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/sourceInputLayout"
                    style="@style/InputFieldStyle"
                    android:hint="@string/source">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etSource"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Total Moisture -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/totalMoistureInputLayout"
                    style="@style/InputFieldStyle"
                    android:hint="@string/total_moisture">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etTotalMoisture"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Inherent Moisture -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/inherentMoistureInputLayout"
                    style="@style/InputFieldStyle"
                    android:hint="@string/inherent_moisture">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etInherentMoisture"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Equilibrial Moisture -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/equilibrialMoistureInputLayout"
                    style="@style/InputFieldStyle"
                    android:hint="@string/equilibrial_moisture">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etEquilibrialMoisture"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Volatile Matter -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/volatileMatterInputLayout"
                    style="@style/InputFieldStyle"
                    android:hint="@string/volatile_matter">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etVolatileMatter"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Ash -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/ashInputLayout"
                    style="@style/InputFieldStyle"
                    android:hint="@string/ash">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etAsh"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClear"
                style="@style/ButtonStyle"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="@string/clear"
                android:backgroundTint="@color/text_secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalculate"
                style="@style/ButtonStyle"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/calculate" />

        </LinearLayout>

        <!-- Results Section Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/resultsCard"
            style="@style/CardViewStyle"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/SectionTitleStyle"
                    android:text="@string/results_title"
                    android:padding="0dp"
                    android:paddingBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@color/input_background"
                    android:padding="12dp">

                    <!-- GCV ADB -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/gcv_adb"
                            android:textSize="14sp"
                            android:textColor="@color/text_secondary" />

                        <TextView
                            android:id="@+id/tvGcvAdb"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0.00 kcal/kg"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />
                    </LinearLayout>

                    <!-- Factor -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/factor"
                            android:textSize="14sp"
                            android:textColor="@color/text_secondary" />

                        <TextView
                            android:id="@+id/tvFactor"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0.00"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />
                    </LinearLayout>

                    <!-- GCV ARB -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/gcv_arb"
                            android:textSize="14sp"
                            android:textColor="@color/text_secondary" />

                        <TextView
                            android:id="@+id/tvGcvArb"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0.00 kcal/kg"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />
                    </LinearLayout>

                    <!-- Equilibrial Factor -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/equilibrial_factor"
                            android:textSize="14sp"
                            android:textColor="@color/text_secondary" />

                        <TextView
                            android:id="@+id/tvEquilibrialFactor"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0.00"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />
                    </LinearLayout>

                </LinearLayout>

                <!-- Coal Grade -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="16dp"
                    android:padding="12dp"
                    android:background="@color/input_background">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/coal_grade"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tvCoalGrade"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Grade A"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/success"
                        android:padding="8dp"
                        android:gravity="center" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
