<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SCC Calculator"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:paddingBottom="4dp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Formula: SCC = Coal ÷ (Unit Gen × 1000)   —   Fill any 2 fields to calculate the 3rd"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:paddingBottom="16dp" />

        <!-- ── INPUTS card ──────────────────────────────────────────────── -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            app:cardElevation="6dp"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="@color/card_background"
            app:strokeColor="@color/primary"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- INPUT badge -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="#1A00897B"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:layout_marginBottom="12dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="INPUT"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary"
                        android:letterSpacing="0.1" />
                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/coalConsumptionInputLayout"
                    style="@style/InputFieldStyle"
                    android:hint="Coal Consumption (tons)">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCoalConsumption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/unitGenerationInputLayout"
                    style="@style/InputFieldStyle"
                    android:hint="Unit Generation (kWh)">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etUnitGeneration"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── OUTPUT card ─────────────────────────────────────────────── -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardElevation="6dp"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="#FFF8E1"
            app:strokeColor="@color/accent"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- OUTPUT badge -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="#1AFF6F00"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:layout_marginBottom="6dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="OUTPUT"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/accent"
                        android:letterSpacing="0.1" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Enter a known value here to back-calculate a missing input"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:paddingBottom="8dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/sccInputLayout"
                    style="@style/InputFieldStyle"
                    android:hint="SCC — Specific Coal Consumption (kg/kWh)">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etScc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClearCoal"
                style="@style/ButtonSecondaryStyle"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="@string/clear"
                android:textColor="@color/primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalculateCoal"
                style="@style/ButtonPrimaryStyle"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/calculate" />
        </LinearLayout>

        <!-- Results -->
        <LinearLayout
            android:id="@+id/resultsContainerCoal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Calculated Result"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:paddingBottom="12dp"
                android:fontFamily="sans-serif-medium" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardElevation="6dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="@color/card_background">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@drawable/result_card_background">

                    <TextView
                        android:id="@+id/tvSccLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Specific Coal Consumption"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary"
                        android:textStyle="bold"
                        android:paddingBottom="4dp" />

                    <TextView
                        android:id="@+id/tvSpecificCoalConsumption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textSize="30sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary"
                        android:gravity="center"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp" />

                    <!-- Row: Coal -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingTop="8dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Coal Consumption"
                            android:textSize="13sp"
                            android:textColor="@color/text_secondary" />
                        <TextView
                            android:id="@+id/tvResultCoal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />
                    </LinearLayout>

                    <!-- Row: Unit -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingTop="6dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Unit Generation"
                            android:textSize="13sp"
                            android:textColor="@color/text_secondary" />
                        <TextView
                            android:id="@+id/tvResultUnit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- Footer -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/footer_credit"
            android:textSize="12sp"
            android:textColor="@color/text_hint"
            android:gravity="center"
            android:paddingTop="24dp"
            android:paddingBottom="12dp"
            android:fontFamily="sans-serif-medium" />

    </LinearLayout>
</ScrollView>
