<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Coal Analysis"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:paddingBottom="8dp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Calculate specific coal consumption"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:paddingBottom="16dp" />

        <!-- Input Section Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardElevation="6dp"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="@color/card_background">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Input Parameters"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:paddingBottom="12dp" />

                <!-- Coal Consumption -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/coalConsumptionInputLayout"
                    style="@style/InputFieldStyle"
                    android:hint="Coal Consumption (tons)">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCoalConsumption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Unit Generation -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/unitGenerationInputLayout"
                    style="@style/InputFieldStyle"
                    android:hint="Unit Generation (kWh)">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etUnitGeneration"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClearCoal"
                style="@style/ButtonSecondaryStyle"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="@string/clear"
                android:textColor="@color/primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalculateCoal"
                style="@style/ButtonPrimaryStyle"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/calculate" />

        </LinearLayout>

        <!-- Results Section -->
        <LinearLayout
            android:id="@+id/resultsContainerCoal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Analysis Results"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:paddingBottom="12dp"
                android:fontFamily="sans-serif-medium" />

            <!-- Specific Coal Consumption Result Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardElevation="6dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="@color/card_background">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:background="@drawable/result_card_background">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Specific Coal Consumption"
                        android:textSize="16sp"
                        android:textColor="@color/text_secondary"
                        android:textStyle="bold"
                        android:paddingBottom="8dp" />

                    <TextView
                        android:id="@+id/tvSpecificCoalConsumption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="0.00 kg/kWh"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary"
                        android:gravity="center"
                        android:padding="12dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </LinearLayout>
</ScrollView>
